# 이 파일을 .env 로 복사한 뒤 실제 키를 입력하세요.
#   cp .env.example .env
#
# crewAI 는 기본적으로 OpenAI 모델을 사용합니다.
OPENAI_API_KEY=sk-...

# 다른 모델을 쓰고 싶다면 (예시):
# MODEL=gpt-4o-mini
# 또는 Anthropic:
# ANTHROPIC_API_KEY=...
# MODEL=anthropic/claude-3-5-sonnet-20241022

# 새 프로젝트를 항상 이 브랜치에서 분기시킵니다 (강력 추천).
# 설정하면 어느 브랜치에서 명령을 실행해도 조직 브랜치(main)에서 분기되어,
# 프로젝트 브랜치 위에서 실수로 또 분기하는 사고를 원천 차단합니다.
ORG_BASE_BRANCH=main
