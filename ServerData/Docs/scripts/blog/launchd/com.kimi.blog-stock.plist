<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.kimi.blog-stock</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/kimi/scripts/blog/blog-orchestrator.sh</string>
    <string>stock</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>6</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Volumes/ServerData/Projects/blog/logs/launchd-stock.log</string>
  <key>StandardErrorPath</key>
  <string>/Volumes/ServerData/Projects/blog/logs/launchd-stock.err</string>
</dict>
</plist>
