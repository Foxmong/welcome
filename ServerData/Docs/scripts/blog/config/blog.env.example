# 블로그 자동화 설정 (chmod 600)

# --- Tistory ---
TISTORY_STOCK_HOST=your-stock.tistory.com
TISTORY_DEAL_HOST=your-deal.tistory.com

# --- API ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
FINNHUB_API_KEY=
DART_API_KEY=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# --- Telegram (승인 + 실패 알림 공용) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- LLM 모델 (비용 최적화 라우팅) ---
BLOG_MODEL_FILTER=google/gemini-2.0-flash-001
BLOG_MODEL_OUTLINE=anthropic/claude-3-haiku
BLOG_MODEL_STOCK=anthropic/claude-sonnet-4
BLOG_MODEL_DEAL=google/gemini-2.0-flash-001
BLOG_MODEL_PUBLISH=anthropic/claude-3-haiku
LLM_MAX_TOKENS=2048
LLM_CACHE_TTL_HOURS=24

# --- 일일 LLM 호출 상한 (품질 유지 + 비용 절약) ---
STOCK_LLM_DAILY_MAX=3
DEAL_LLM_DAILY_MAX=8
STOCK_LLM_DEEP_WEEKLY_MAX=2

# --- 실패 알림 ---
ALERT_ENABLED=1
ALERT_COOLDOWN_SEC=3600
ALERT_MAX_RETRIES=3
ALERT_RETRY_DELAY_SEC=30

BLOG_ROOT=/Volumes/ServerData/Projects/blog
PIPELINE_STOCK_PAUSED=0
PIPELINE_DEAL_PAUSED=0

# --- 크롤·큐 ---
FMKOREA_HOTDEAL_URL=https://www.fmkorea.com/index.php?mid=hotdeal
CRAWL_DELAY_SEC=2
CONTENT_DEDUP_DAYS=7
DEAL_CANDIDATE_MAX=20
DEAL_PUBLISH_DAILY_MAX=8
