# 블로그 자동화 설정 (chmod 600)
# 복사: cp blog.env.example /Volumes/ServerData/Projects/blog/config/blog.env

# --- Tistory ---
TISTORY_STOCK_HOST=your-stock.tistory.com
TISTORY_DEAL_HOST=your-deal.tistory.com

# --- API ---
OPENROUTER_API_KEY=
FINNHUB_API_KEY=
DART_API_KEY=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=

# --- Telegram (승인 + 실패 알림 공용) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- 실패 알림 ---
ALERT_ENABLED=1
ALERT_COOLDOWN_SEC=3600
ALERT_MAX_RETRIES=3
ALERT_RETRY_DELAY_SEC=30

# 파이프라인 일시 중지 플래그 (실패 알림 후 수동/콜백으로 해제)
BLOG_ROOT=/Volumes/ServerData/Projects/blog
PIPELINE_STOCK_PAUSED=0
PIPELINE_DEAL_PAUSED=0

# 크롤
FMKOREA_HOTDEAL_URL=https://www.fmkorea.com/index.php?mid=hotdeal
CRAWL_DELAY_SEC=2
