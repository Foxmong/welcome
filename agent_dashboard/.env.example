# 이 파일을 .env 로 복사한 뒤 실제 키를 입력하세요.
#   cp .env.example .env
#
# Cursor Dashboard(https://cursor.com/dashboard?tab=integrations) 에서
# API 키를 발급받아 입력하세요. (모델 제공사 API 키가 아닌, Cursor 자체 API 키입니다.)
CURSOR_API_KEY=your_cursor_api_key_here

# 특정 저장소만 보고 싶다면 "owner/repo" 형식으로 지정 (선택, 비워두면 전체 표시)
CURSOR_DASHBOARD_REPO_FILTER=

# 대시보드 자동 새로고침 주기(초)
CURSOR_DASHBOARD_REFRESH_SECONDS=15
